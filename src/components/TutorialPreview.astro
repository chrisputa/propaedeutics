---
import { type CollectionEntry } from 'astro:content';
import Link from '../components/Link.astro';
import ArrowRight from '../icons/ArrowRight.astro';
import FormattedDate from './FormattedDate.astro';

type Props = { tutorial: CollectionEntry<'tutorials'>; class?: string; headingLevel?: 'h2' | 'h3'; sequence?: number };

const { tutorial, class: className, headingLevel = 'h2', sequence } = Astro.props;
const { title, description, publishDate, updatedDate } = tutorial.data;
const TitleTag = headingLevel;

---

<Link class:list={['flex justify-between items-start gap-8 group', className]} href={`/tutorials/${tutorial.id}/`}>
    <div class="grow">
        <TitleTag
            class="text-[27px] leading-tight font-display font-normal tracking-[0.005em] group-hover:underline group-hover:decoration-dashed group-hover:underline-offset-4 group-hover:decoration-1 sm:text-[27px]"
        >
            {title}
        </TitleTag>
        <div class="mt-1 text-base font-sans leading-normal text-muted">
            <FormattedDate date={publishDate} />
            {
                updatedDate && (
                    <>
                        {' '}
                        <span>
                            (Updated on <FormattedDate date={updatedDate} />)
                        </span>
                    </>
                )
            }
        </div>
        {description && <div class="mt-2 border-l border-[var(--text-main)] pl-4 text-[18px] leading-[1.6] font-sans text-justify text-muted">{description}</div>}
    </div>
    <div class="hidden font-display tracking-[0.04em] opacity-0 transition group-hover:opacity-100 sm:inline-flex sm:gap-1 sm:items-center sm:shrink-0">
        View Tutorial <ArrowRight class="fill-current w-4 h-4" />
    </div>
</Link>
