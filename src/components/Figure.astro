---
import { Image } from 'astro:assets';
import { getNextFigureNumber } from '../utils/figure-registry.js';

// `panels` lets one caption cover several stacked images (e.g. two related
// panels sharing a description). Each entry is { src, srcDark?, alt } and gets
// its own figure number, so the label collapses to a range: "Figure 2 & 3."
//
// `label` replaces the auto-generated one and, crucially, leaves the per-page
// registry untouched — the figure index reuses this component to re-display
// figures under the number they carry in their own lecture, and must not
// disturb any numbering on the page it renders into.
const { src, alt, srcDark, margin = false, panels = [], label } = Astro.props;

const hasCaption = Astro.slots.has('default');

let figLabel = label;

if (!label) {
    // Reserve one number per image so physical figure order stays correct.
    const startNum = getNextFigureNumber();
    let endNum = startNum;
    for (let i = 0; i < panels.length; i++) endNum = getNextFigureNumber();

    figLabel = !hasCaption
        ? undefined
        : endNum === startNum
            ? `Figure ${startNum}`
            : endNum === startNum + 1
                ? `Figure ${startNum} & ${endNum}`
                : `Figure ${startNum}–${endNum}`;
}

if (!hasCaption) figLabel = undefined;

const images = [{ src, srcDark, alt }, ...panels];
---

<figure class={margin ? 'm-0 md:mr-[-53%] md:float-right md:clear-end md:w-[53%] px-6' : 'm-0'}>
    {
        !margin && hasCaption && (
            <figcaption
                class="hidden md:block md:mr-[-53%] md:float-right md:clear-end md:w-[53%] px-6"
                data-figlabel={figLabel}
            >
                <slot />
            </figcaption>
        )
    }

    {
        images.map((img, i) => {
            // Give every panel after the first some breathing room so stacked,
            // related images don't touch (the first image keeps py-0).
            const gap = i > 0 ? ' mt-6!' : '';
            // Without a dark variant the light image has to stay visible in dark
            // mode too — otherwise the figure disappears there entirely.
            const lightVisibility = img.srcDark ? 'block dark:hidden' : 'block';
            return (
                <Fragment>
                    <Image src={img.src} alt={img.alt} class={`w-full h-auto py-0 ${lightVisibility}${gap}`} />
                    {img.srcDark && (
                        <Image src={img.srcDark} alt={img.alt} class={`w-full h-auto py-0 hidden dark:block${gap}`} />
                    )}
                </Fragment>
            );
        })
    }

    {
        hasCaption && (
            <figcaption
                class={margin ? 'block px-6 md:px-0 my-4' : 'block md:hidden px-6 my-4'}
                data-figlabel={figLabel}
            >
                <slot />
            </figcaption>
        )
    }
</figure>
