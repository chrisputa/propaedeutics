---
// Wraps a markdown table so its caption sits in the side margin with the same
// treatment as figure captions (thin rule + bare auto number). The table goes
// in the default slot; the caption text in the "caption" slot. Numbering is a
// per-lecture counter, independent from figures — see table-registry.js.
import { getNextTableNumber } from '../utils/table-registry.js';

const label = `Table ${getNextTableNumber()}`;
---

<figure class="m-0">
    <figcaption
        class="hidden md:block md:mr-[-53%] md:float-right md:clear-end md:w-[53%] px-6"
        data-figlabel={label}
    >
        <slot name="caption" />
    </figcaption>

    <!-- Constrain wide tables to the content column so they can't bleed into the
         (floated) caption gutter; overflow scrolls horizontally instead. -->
    <div class="overflow-x-auto max-w-full"><slot /></div>

    <figcaption class="block md:hidden px-6 my-4" data-figlabel={label}>
        <slot name="caption" />
    </figcaption>
</figure>
